# Copy to `.env` and adjust. Every setting is optional; the values below are the defaults.
#
# Precedence: real environment variables > .env > built-in defaults.
# The file is read once at startup (dev, production and `pnpm dataset:fetch`) through
# Effect's ConfigProvider; it is not loaded into process.env. `.env` is git-ignored.

# --- Server -------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=3000
# Time in-flight requests get to finish on SIGTERM before connections are force-closed.
# SHUTDOWN_TIMEOUT=10 seconds
# json | logfmt | pretty
# LOG_FORMAT=logfmt
# Trace | Debug | Info | Warn | Error | Fatal | None
# LOG_LEVEL=Info

# --- PokemonCatalog adapter ---------------------------------------------------
# in-memory (bundled dataset, no network) | http (live PokeAPI)
# POKEMON_CATALOG=in-memory

# in-memory adapter: dataset file, relative to the working directory.
# Regenerate it with `pnpm dataset:fetch`.
# POKEMON_DATASET_PATH=data/pokemon.json

# http adapter
# POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# Timeout per attempt (any Effect Duration string, e.g. "500 millis", "3 seconds").
# POKEAPI_TIMEOUT=3 seconds
# Retries after the first attempt, for transient failures only (timeouts, 429, 5xx, network).
# POKEAPI_RETRIES=2

# --- Telemetry (OTLP/HTTP export of Effect traces, metrics and logs) ------------
# Standard OpenTelemetry variable names. Export is best-effort: no collector, no problem.
# OTEL_SDK_DISABLED=false
# OTEL_SERVICE_NAME=pokedex
# Defaults to package.json's version.
# OTEL_SERVICE_VERSION=0.0.0
# Base URL; signals go to <endpoint>/v1/traces, /v1/metrics and /v1/logs.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Per-signal endpoints, used as-is (override the base URL for that signal).
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# otlp | none, per signal
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=otlp
# http/protobuf | http/json
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Extra request headers, e.g. for collector auth: key=value,key2=value2 (values URI-encoded).
# OTEL_EXPORTER_OTLP_HEADERS=
# Extra resource attributes (read by Effect's OTLP exporter): key=value,key2=value2
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev
# Milliseconds between metric exports (the spec default is 60000; 10 s keeps dashboards live).
# OTEL_METRIC_EXPORT_INTERVAL=10000
# How often Node.js runtime metrics (event loop, heap, CPU, GC) are sampled.
# RUNTIME_METRICS_INTERVAL=5 seconds

# --- The env file itself ------------------------------------------------------
# Only honoured as a real environment variable (it locates this file).
# Set it empty to ignore .env entirely, e.g. `DOTENV_PATH= pnpm start`.
# DOTENV_PATH=.env
