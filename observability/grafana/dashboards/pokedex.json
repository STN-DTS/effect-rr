{
  "uid": "pokedex-overview",
  "title": "Pokédex: Effect + React Router",
  "description": "RED metrics, Effect runtime, business metrics, PokeAPI, Node.js runtime, logs and traces for the Pokédex PoC.",
  "tags": ["pokedex", "effect", "react-router", "opentelemetry"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
